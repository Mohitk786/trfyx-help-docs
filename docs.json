{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Trfyx Documentation",
  "colors": {
    "primary": "#c4471f",
    "light": "#d86c48",
    "dark": "#c4471f"
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Getting Started",
        "icon": "book-open",
        "pages": [
          "index",
          "quickstart",
          "install-tracking"
        ]
      },
      {
        "dropdown": "Analytics & Insights",
        "icon": "chart-line",
        "pages": [
          "analytics/overview"
        ]
      },
      {
        "dropdown": "Behavior Analytics",
        "icon": "arrow-pointer",
        "pages": [
          "session-replay",
          "user-journeys"
        ]
      },
      {
        "dropdown": "Installation Guide",
        "icon": "download",
        "pages": [
          "google-tag-manager",
          "nextjs-app-router",
          "react-router",
          "vuejs",
          "astro",
          "django",
          "laravel",
          "shopify",
          "webflow",
          "framer",
          "wix",
          "squarespace",
          "ghost-cms",
          "bubble",
          "podia",
          "kajabi",
          "lovable",
          "bolt",
          "vercel-v0",
          "replit"
        ]
      },
      {
        "dropdown": "Proxy setup",
        "icon": "shield-halved",
        "pages": [
          "proxy-guide",
          "managed-proxy",
          "nextjs-proxy",
          "express-proxy",
          "php-proxy",
          "fastapi-proxy",
          "flask-proxy",
          "vuejs-proxy",
          "nginx-proxy",
          "caddy-proxy",
          "astro-proxy",
          "firebase-proxy",
          "laravel-proxy",
          "digitalocean-proxy"
        ]
      },
      {
        "dropdown": "Goals & Attribution",
        "icon": "bullseye",
        "pages": [
          "goals",
          "funnels",
          "revenue-attribution"
        ]
      },
      {
        "dropdown": "Data & Sharing",
        "icon": "database",
        "pages": [
          "import-analytics-data",
          "embedded-dashboards"
        ]
      },
      {
        "dropdown": "Troubleshooting",
        "icon": "life-ring",
        "pages": [
          "troubleshooting"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Visit Trfyx",
      "href": "https://trfyx.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Developer documentation for Trfyx — analytics, attribution, funnels, session replay, user journeys, goals, revenue, and integrations for SaaS and modern web products.",
  "logo": {
    "light": "/images/trfyx-icon.png",
    "dark": "/images/trfyx-dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "IBM Plex Sans",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true,
    "codeblocks": "dark"
  },
  "favicon": {
    "light": "/images/trfyx-icon.png",
    "dark": "/images/trfyx-icon.png"
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": false
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/trfyx",
      "website": "https://www.trfyx.com/"
    }
  },
  "variables": {
    "SCRIPT_PATH": "https://app.trfyx.com/script.js"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#fbfaf8",
      "dark": "#181818"
    }
  }
}
