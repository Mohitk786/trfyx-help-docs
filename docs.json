{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Trfyx help docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Analytics & Insights",
        "icon": "chart-no-axes-combined",
        "pages": [
          "analytics/overview"
        ]
      },
      {
        "group": "Behavior Analytics",
        "icon": "mouse-pointer-click",
        "pages": [
          "session-replay",
          "user-journeys"
        ]
      },
      {
        "group": "Goals & Attribution",
        "icon": "target",
        "pages": [
          "goals",
          "funnels",
          "revenue-attribution"
        ]
      },
      {
        "group": "Data & Sharing",
        "icon": "database",
        "pages": [
          "import-analytics-data",
          "embedded-dashboards"
        ]
      },
      {
        "group": "Troubleshooting",
        "icon": "life-buoy",
        "pages": [
          "troubleshooting"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
